# Configuration of the compose stack (`make up`). `make env` copies this file to .env and fills
# in random secrets; nothing secret has a default value in this repository.
#
# For `npm run dev` the same LEDGERD_API_KEY is used: it is read from .env, then from .env.local
# (which wins), so a stack started with `make up` is ready to develop against.

# The API key of ledgerd. The console server holds it and adds it to forwarded requests; it
# never reaches the browser.
LEDGERD_API_KEY=

POSTGRES_SUPERUSER_PASSWORD=
LEDGERD_OWNER_PASSWORD=
LEDGERD_APP_PASSWORD=

# Ports published on this machine (127.0.0.1 only).
# CONSOLE_PORT=8787
# LEDGERD_PORT=8085

# Where ledgerd is, for `npm run dev` (the default is the port published above).
# LEDGERD_URL=http://127.0.0.1:8085
