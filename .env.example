# Copy to .env.local (never commit it) for `npm run dev`.

# The API key of your ledgerd. For the stack in the ledgerd repository this is the
# LEDGERD_API_KEY in its .env (created by `make env`).
LEDGERD_API_KEY=

# Where ledgerd listens (default: the ledgerd repository's `make up`).
# LEDGERD_URL=http://127.0.0.1:8085
