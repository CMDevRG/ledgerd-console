{
  "name": "ledgerd-console",
  "version": "0.0.0",
  "private": true,
  "description": "A web console for ledgerd: explore accounts, move money, and watch the ledger prove itself.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ${LEDGERD_OPENAPI:-../ledgerd/docs/openapi.yaml} -o src/api/schema.d.ts",
    "check:api": "npm run generate:api --silent && git diff --exit-code -- src/api/schema.d.ts",
    "verify": "npm run typecheck && npm run check:api-types && npm run lint && npm run format:check && npm run test && npm run build",
    "check:api-types": "tsc --noEmit --ignoreConfig --strict --skipLibCheck false src/api/schema.d.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.104.2",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
